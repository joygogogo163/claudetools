{
  "manifest_version": 3,
  "name": "VibeSlash 指令助手",
  "short_name": "VibeSlash",
  "version": "1.0.0",
  "description": "适用于 Claude Code 网页版的斜杠命令助手：输入 / 弹出中文联想，Alt+K 打开指令面板；每条指令附用途、示例和注意事项，支持自定义指令。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "VibeSlash 指令助手",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "clipboardWrite"],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["commands.js", "core.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "toggle-palette": {
      "suggested_key": { "default": "Alt+K" },
      "description": "打开或关闭指令面板"
    }
  }
}
