{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VibeSlash",
  "mainBinaryName": "VibeSlash",
  "identifier": "dev.vibeslash.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev:ui",
    "beforeBuildCommand": "pnpm build:ui"
  },
  "app": {
    "windows": [
      {
        "label": "palette",
        "url": "index.html",
        "title": "VibeSlash 指令面板",
        "width": 560,
        "height": 440,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": true,
        "center": true
      },
      {
        "label": "settings",
        "url": "settings.html",
        "title": "VibeSlash 指令助手 设置",
        "width": 720,
        "height": 680,
        "minWidth": 520,
        "minHeight": 480,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "VibeSlash",
    "shortDescription": "Claude Code、Codex 命令速查表：不用背命令，按一下就出来。",
    "longDescription": "VibeSlash 指令助手常驻托盘，在 Claude 桌面 App、ChatGPT 桌面 App 的 Codex 模式和终端里按 Alt+/ 呼出斜杠指令面板，自动识别当前客户端，选中即插入。",
    "category": "DeveloperTool",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
