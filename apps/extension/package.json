{
  "name": "@vibeslash/extension",
  "version": "1.2.0",
  "private": true,
  "description": "VibeSlash 指令助手浏览器扩展：适用于 Claude Code 网页版的斜杠指令中文联想与速查，弹出页可查 Codex 指令",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build.mjs && node --test --test-concurrency=1 tests/*.test.mjs",
    "zip": "node scripts/build.mjs && node scripts/pack.mjs",
    "screenshots": "node scripts/build.mjs && node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@vibeslash/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "esbuild": "0.25.11",
    "orderedmap": "2.1.1",
    "playwright": "1.56.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.12",
    "prosemirror-schema-basic": "1.2.5",
    "prosemirror-state": "1.4.4",
    "prosemirror-transform": "1.12.2",
    "prosemirror-view": "1.42.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "w3c-keyname": "2.2.8"
  }
}
