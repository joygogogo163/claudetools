{
  "manifest_version": 3,
  "name": "VibeSlash 指令助手",
  "short_name": "VibeSlash",
  "version": "1.2.0",
  "description": "Claude Code、Codex 命令速查表（也支持 DeepSeek）：不用背命令，输入 / 或按 Alt+K 就出来，每条附中文用途、示例和注意事项。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "VibeSlash 指令助手",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "clipboardWrite",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "toggle-palette": {
      "suggested_key": {
        "default": "Alt+K"
      },
      "description": "打开或关闭指令面板"
    }
  }
}
